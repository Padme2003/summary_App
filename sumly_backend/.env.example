PORT=5000
MONGODB_URI=mongodb://localhost:27017/sumly_db
JWT_SECRET=your_jwt_secret_here
GEMINI_API_KEY=your_gemini_api_key_here
NODE_ENV=development

# Google Text-to-Speech (opcional)
# Para Railway: pega el JSON completo de google-tts.json en una sola línea
# GOOGLE_TTS_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-tts.json
